# ResuCraft AI — Environment Configuration Template
# Copy this file to .env for local development

# ==========================================
# Database Configuration (PostgreSQL 18)
# ==========================================
# Format: postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/resucraft_dev?schema=public"

# ==========================================
# Backend API (NestJS)
# ==========================================
PORT=4000
API_PREFIX="api"
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# Frontend (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# ==========================================
# AI Provider (Phase 6 - Optional BYOK)
# ==========================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""
